# Copie para .env (o scripts/setup.ps1 faz isso). Nunca commite o .env.

# Postgres local do docker-compose.yml (só desenvolvimento; credenciais de exemplo).
# Porta 55432 no host para não conflitar com Postgres instalados direto no Windows (5432, 5433).
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=portfolio
POSTGRES_PORTA_HOST=55432
DATABASE_URL=postgresql://portfolio:troque-esta-senha-local@localhost:55432/portfolio
